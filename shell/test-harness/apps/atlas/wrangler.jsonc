{
  "name": "election-atlas",
  "main": "worker.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/elections",
      "/elections/",
      "/elections/india/data/state-legislation/*",
      "/work/election-atlas",
      "/work/election-atlas/*",
      // proposed: the four pages, so their HTML passes through compose()
      "/elections/india/",
      "/elections/india/state/",
      "/elections/india/mp/",
      "/elections/india/mla/",
      // proposed, until the /_site/* route: site-shell's files through this Worker
      "/elections/india/_site/*"
    ]
  },
  // The real config also binds R2 (DOCS) and D1; the harness never reaches them.
  "services": [{ "binding": "SHELL", "service": "site-shell" }]
}
