{
  "name": "ai-chat-archive-frontend",
  "main": "worker.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": false,
  // as today: the page still bundles site-themes v0.2.0
  "assets": { "directory": "./out", "binding": "ASSETS", "run_worker_first": true },
  "services": [{ "binding": "SHELL", "service": "site-shell" }]
}
