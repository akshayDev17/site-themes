{
  "name": "site-themes",
  "version": "0.2.0",
  "description": "Shared themes for the akshayprabhakant.com apps: the build-time package and the site-shell Worker",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": "github:akshayDev17/site-themes",
  "files": ["dist"],
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "boot": ["./dist/boot.d.ts"],
      "picker": ["./dist/picker.d.ts"],
      "react": ["./dist/react.d.ts"],
      "themes": ["./dist/themes.d.ts"]
    }
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./boot": { "types": "./dist/boot.d.ts", "default": "./dist/boot.js" },
    "./picker": { "types": "./dist/picker.d.ts", "default": "./dist/picker.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./themes": { "types": "./dist/themes.d.ts", "default": "./dist/themes.js" },
    "./themes.css": "./dist/themes.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist build && tsc -p tsconfig.json && tsc -p tsconfig.tools.json && node build/scripts/generate.js && node build/scripts/build-shell.js",
    "test": "npm run build && tsc -p shell/tsconfig.json && node --test \"build/test/*.test.js\"",
    "test:shell": "node --test shell/test-harness/harness.test.mjs",
    "test:row": "node --test shell/test-harness/row.browser.test.mjs",
    "check:contrast": "tsc -p tsconfig.tools.json && node build/scripts/check-contrast.js",
    "dev:shell": "wrangler dev -c shell/wrangler.jsonc"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "miniflare": "5.20261019.2-beta",
    "typescript": "~5.9.3",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=20"
  }
}
